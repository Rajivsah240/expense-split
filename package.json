{
  "name": "expense-split",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.ts",
    "build": "npm run icons && vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs --production",
    "icons": "node scripts/gen-icons.mjs",
    "push:keys": "web-push generate-vapid-keys",
    "test": "tsx scripts/test-parser.ts && tsx scripts/test-push.ts",
    "lint": "tsc --noEmit",
    "db:reset": "node --env-file=.env scripts/reset-db.mjs",
    "db:indexes": "tsx --env-file=.env scripts/sync-indexes.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "smoke:ai": "tsx --env-file=.env scripts/smoke-ai.ts",
    "seed:demo": "tsx --env-file=.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.9.1",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^5.9.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
