# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Server-only: never prefix with VITE_.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="expense_split_db"

# ─── Sessions ────────────────────────────────────────────────────────────────
# Signs both the auth tokens and the OTP hashes. Must be 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# ─── Sign-in email (Gmail SMTP) ──────────────────────────────────────────────
# Use a Google App Password, not your account password.
SMTP_USER="your-address@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="Expense Split <your-address@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"

# Local development only: prints the sign-in code to the server console so you
# can sign in even when SMTP is unavailable. Leave unset in production.
# OTP_DEV_LOG="true"

# ─── AI parsing ──────────────────────────────────────────────────────────────
# Used for messy text, receipt photos and WhatsApp chat import.
# The rule-based parser handles clean input with no API call at all.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"

# ─── Insights ────────────────────────────────────────────────────────────────
# Timezone used to bucket spending into months and weekdays.
STATS_TIMEZONE="Asia/Kolkata"
