# GEMINI_API_KEY: Required for Gemini AI API calls (receipt scanning and WhatsApp parsing)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# MongoDB Atlas connection string. Keep this server-only (no VITE_ prefix).
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/expense-split?retryWrites=true&w=majority"

# Long random secret used to sign authenticated sessions (at least 32 characters).
JWT_SECRET="replace-with-a-long-random-secret"

# Gmail SMTP. Use a Google App Password, not your normal Gmail password.
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-16-character-google-app-password"
SMTP_FROM="Expense Split <your-gmail-address@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
